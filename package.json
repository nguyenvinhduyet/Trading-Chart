{
  "name": "@dylanpersonguy/opencharts",
  "version": "0.3.0",
  "description": "Open-source trading terminal: advanced charting, drawing tools and a built-in paper-trading engine, with no backend required.",
  "keywords": [
    "trading",
    "charting",
    "candlestick",
    "trading-terminal",
    "lightweight-charts",
    "react",
    "paper-trading",
    "drawing-tools",
    "technical-analysis"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dylanpersonguy/OpenCharts.git"
  },
  "homepage": "https://github.com/dylanpersonguy/OpenCharts#readme",
  "bugs": {
    "url": "https://github.com/dylanpersonguy/OpenCharts/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist-lib",
    "NOTICE",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/index.d.ts",
      "import": "./dist-lib/index.js"
    },
    "./demo": {
      "types": "./dist-lib/demo.d.ts",
      "import": "./dist-lib/demo.js"
    },
    "./conformance": {
      "types": "./dist-lib/adapter/conformance.d.ts",
      "import": "./dist-lib/conformance.js"
    },
    "./style.css": "./dist-lib/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "dev:ci": "vite --host 0.0.0.0 --port 5173",
    "build": "vite build",
    "check:size": "node scripts/check-bundle-size.mjs",
    "build:lib": "vite build --config vite.lib.config.ts && node scripts/build-lib-css.mjs",
    "check:package": "node scripts/check-package.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm run lint -- --max-warnings=0 && npm run test && npm run build:lib && npm run check:package"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "vitest": ">=2"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tanstack/react-query": "^5.107.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fancy-canvas": "^2.1.0",
    "lightweight-charts": "^4.2.0",
    "lucide-react": "^0.575.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.32",
    "postcss-prefix-selector": "^2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^2.1.9"
  }
}
